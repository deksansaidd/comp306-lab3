@model LearningPortal.Models.LearningResource
@using LearningPortal.Models
@using System.Security.Claims

@{
    ViewData["Title"] = Model.Title;

    int currentUserId = int.Parse(
        User.FindFirst(ClaimTypes.NameIdentifier)!.Value);

    var comments = ViewBag.Comments as List<CommentItem>
        ?? new List<CommentItem>();
}

<h2>@Model.Title</h2>

<p class="text-muted">
    @Model.Category.CategoryName &middot;
    by @Model.Author.Username &middot;
    @Model.CreatedDate.ToString("yyyy-MM-dd") &middot;
    @Model.ViewCount views
</p>

<p>@Model.Description</p>

<div class="mb-3">
    <a asp-action="Download"
       asp-route-id="@Model.ResourceId"
       asp-route-inline="true"
       target="_blank"
       class="btn btn-primary">Open</a>

    <a asp-action="Download"
       asp-route-id="@Model.ResourceId"
       class="btn btn-outline-primary">Download</a>

    @if (Model.AuthorId == currentUserId)
    {
        <a asp-action="Edit"
           asp-route-id="@Model.ResourceId"
           class="btn btn-outline-secondary">Edit</a>

        <a asp-action="Delete"
           asp-route-id="@Model.ResourceId"
           class="btn btn-outline-danger">Delete</a>
    }
</div>

<a asp-action="Index">Back to the list</a>

<hr class="my-4" />

<h3>Comments (@comments.Count)</h3>

@if (TempData["CommentError"] != null)
{
    <div class="alert alert-danger">
        @TempData["CommentError"]
    </div>
}

@if (!comments.Any())
{
    <p class="text-muted">
        No comments yet. Be the first to comment!
    </p>
}
else
{
    @foreach (var comment in comments.OrderByDescending(c => c.CreatedUtc))
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <strong>@comment.Username</strong>

                    <small class="text-muted">
                        @comment.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                    </small>
                </div>

                <p class="mt-2">@comment.Text</p>

                @if (comment.CanEdit(currentUserId))
                {
                    <details>
                        <summary class="btn btn-sm btn-outline-secondary">
                            Edit Comment
                        </summary>

                        <form asp-controller="Comments"
                              asp-action="Edit"
                              method="post"
                              class="mt-3">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="resourceId"
                                   value="@Model.ResourceId" />

                            <input type="hidden"
                                   name="commentId"
                                   value="@comment.CommentId" />

                            
                            <label for="edit-comment-@comment.CommentId"
                                   class="form-label">
                                Edit your comment
                            </label>

                            <textarea id="edit-comment-@comment.CommentId"
                                      name="text"
                                      class="form-control mb-2"
                                      rows="3"
                                      maxlength="1000"
                                      required>@comment.Text</textarea>


                            <button type="submit"
                                    class="btn btn-primary btn-sm">
                                Save Changes
                            </button>
                        </form>
                    </details>
                }
            </div>
        </div>
    }
}

<h4 class="mt-4">Add a Comment</h4>

<form asp-controller="Comments"
      asp-action="Create"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden"
           name="resourceId"
           value="@Model.ResourceId" />

    <div class="mb-3">

        <label for="new-comment" class="form-label">
            Write a comment
        </label>

        <textarea id="new-comment"
                  name="text"
                  class="form-control"
                  rows="4"
                  maxlength="1000"
                  placeholder="Write your comment..."
                  required></textarea>

    </div>

    <button type="submit" class="btn btn-primary">
        Post Comment
    </button>
</form>
